# ==========================================================================
# 复制本文件为 .env，填入你自己的值。.env 已被 .gitignore 排除，不会进仓库。
# ==========================================================================

# ---- 必填：Dify 应用 API Key ----
# 获取路径：Dify 应用 → 左侧「访问 API」→ 右上角「API 密钥」→ 创建密钥
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 选填 ----
# Dify API 域名。官方云版固定为 https://api.dify.ai/v1
# 自部署改成你自己的，例如 http://192.168.1.10/v1
DIFY_API_BASE=https://api.dify.ai/v1

# 本地服务端口
PORT=8787

# 身份注入方式：
#   inputs = 通过 Dify 应用输入变量传递（推荐，需在 Chatflow「开始」节点建好变量）
#   prefix = 拼接到问题前面（不想改 Dify 应用时用这个，最省事）
#   both   = 两者都做
DIFY_IDENTITY_MODE=inputs

# 仅用于页面右上角展示
DIFY_APP_NAME=云栖智能客服 Agent
